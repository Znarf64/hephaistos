// This is purely for documentation

type_is_vector     :: proc($T: typeid) -> bool ---
type_is_float      :: proc($T: typeid) -> bool ---
type_is_boolean    :: proc($T: typeid) -> bool ---
type_is_integer    :: proc($T: typeid) -> bool ---
type_is_numeric    :: proc($T: typeid) -> bool ---
type_is_complex    :: proc($T: typeid) -> bool ---
type_is_quaternion :: proc($T: typeid) -> bool ---
type_is_matrix     :: proc($T: typeid) -> bool ---

count_ones   :: proc(i: $I) where type_is_integer(I) || type_is_vector(I) -> I ---
count_zeros  :: proc(i: $I) where type_is_integer(I) || type_is_vector(I) -> I ---
reverse_bits :: proc(i: $I) where type_is_integer(I) || type_is_vector(I) -> I ---

// read the subgroup clock, this requires the "SPV_KHR_shader_clock" extension
read_subgroup_clock :: proc() -> u64 ---
// read the device clock, this requires the "SPV_KHR_shader_clock" extension
read_device_clock   :: proc() -> u64 ---

// synchronize workgroup control flow and memory
barrier :: proc()
