// This is purely for documentation
import "intrinsics"

min   :: proc(values: ..$T) -> T ---
max   :: proc(values: ..$T) -> T ---
clamp :: proc(value, minimum, maximum: T) -> T ---

inverse     :: proc(m: matrix[$N, N]$E) -> matrix[N, N]E ---
transpose   :: proc(m: matrix[$N, $M]$E) -> matrix[$M, $N]$E ---
determinant :: proc(m: matrix[$N, N]$E) -> E ---

dot       :: proc(a, b: [$N]$E) -> E ---
cross     :: proc(a, b [$N]$E) -> [N]E ---
distance  :: proc(a, b: [$N]$E) -> E ---
reflect   :: proc(i, n: [$N]$E) -> [N]E ---
refract   :: proc(i, n: [$N]$E, eta: E) -> [N]E ---
normalize :: proc(v: [$N]$E) -> [N]E ---
length    :: proc(v: [$N]$E) -> E ---

pow          :: proc(x: $T) -> T ---
sqrt         :: proc(x: $T) -> T ---
sin          :: proc(x: $T) -> T ---
cos          :: proc(x: $T) -> T ---
tan          :: proc(x: $T) -> T ---
sinh         :: proc(x: $T) -> T ---
cosh         :: proc(x: $T) -> T ---
tanh         :: proc(x: $T) -> T ---
asin         :: proc(x: $T) -> T ---
acos         :: proc(x: $T) -> T ---
atan         :: proc(x: $T) -> T ---
asinh        :: proc(x: $T) -> T ---
acosh        :: proc(x: $T) -> T ---
atanh        :: proc(x: $T) -> T ---
atan2        :: proc(x, y: $T) -> T ---
exp          :: proc(x: $T) -> T ---
log          :: proc(x: $T) -> T ---
exp2         :: proc(x: $T) -> T ---
log2         :: proc(x: $T) -> T ---
fract        :: proc(x: $T) -> T ---
floor        :: proc(x: $T) -> T ---
ceil         :: proc(x: $T) -> T ---
round        :: proc(x: $T) -> T ---
trunc        :: proc(x: $T) -> T ---
inverse_sqrt :: proc(x: $T) -> T ---
abs          :: proc(x: $T) -> T ---
sign         :: proc(x: $T) -> T ---
copy_sign    :: proc(x, y: $T) -> T ---

card         :: proc(x: $T) -> i32 where intrinsics.type_is_bit_set(T) ---

smooth_step :: proc(start, end, x: $T) -> T ---
lerp        :: proc(start, end, x: $T) -> T ---

conj :: proc(x: $T) -> T where intrinsics.type_is_quaternion(T) || intrinsics.type_is_complex(T) ---
real :: proc(x: $T) -> T where intrinsics.type_is_quaternion(T) || intrinsics.type_is_complex(T) ---
imag :: proc(x: $T) -> T where intrinsics.type_is_quaternion(T) || intrinsics.type_is_complex(T) ---
jmag :: proc(x: $T) -> T where intrinsics.type_is_quaternion(T) ---
kmag :: proc(x: $T) -> T where intrinsics.type_is_quaternion(T) ---

texture_size :: proc(t: $T/sampler[$N]$E) -> [N]i32 ---
image_size   :: proc(i: $I/image[$N]$E)   -> [N]i32 ---

discard :: proc() -> ! ---

ddx :: proc($T) -> T ---
ddy :: proc($T) -> T ---

size_of  :: proc(T: $typeid) -> int ---
align_of :: proc(T: $typeid) -> int ---
type_of  :: proc(x: expr) -> type ---
