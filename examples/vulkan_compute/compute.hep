@(uniform, binding = 0)
noise:  image[2]f32
@(uniform, binding = 1)
output: image[2][4]f32

@(push_constant)
constants: #import(Compute_Constants)

@(compute_shader)
main :: proc() {
	coord      := $GlobalInvocationId.xy
	image_size := image_size(output)
	uv         := 2 * ([2]f32)(coord) / ([2]f32)(image_size) - 1
	uv.y       *= f32(image_size.y) / f32(image_size.x)
	uv          = uv * 0.5 + 0.5

	complex :: [2]f32

	complex_mul :: proc(a, b: complex) -> complex {
		return { a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x, }
	}

	c := complex{ -0.4, 0.6, }
	z := 3 * (uv - 0.5)
	i := 0.0
	for i < 255 && length(z) < 2 {
		z  = complex_mul(z, z) + c
		i += 1
	}

	t            := (i - log2(max(length(z), 1)) + (noise[coord] - 0.5) * constants.noise) / 256
	output[coord] = lerp(constants.background, constants.foreground, t)
}
