Query                  :: opaque(TypeRayQueryKHR)
Acceleration_Structure :: opaque(TypeAccelerationStructureKHR, u64)

Ray_Flag_Bits :: enum {
	Opaque                     = 0,
	NoOpaque                   = 1,
	TerminateOnFirstHit        = 2,
	SkipClosestHitShader       = 3,
	CullBackFacingTriangles    = 4,
	CullFrontFacingTriangles   = 5,
	CullOpaque                 = 6,
	CullNoOpaque               = 7,
	SkipTriangles              = 8,
	SkipAABBs                  = 9,
	ForceOpacityMicromap2State = 10,
}

Ray_Flags :: bit_set[Ray_Flag_Bits; i32]

Intersection :: enum i32 {
	Candidate = 0,
	Committed = 1,
}

#capability(RayQueryKHR)

extension "SPV_KHR_ray_query" {
	RayQueryInitializeKHR :: proc(
		#by_ptr ray_query:      Query,
		acceleration_structure: Acceleration_Structure,
		ray_flags:              Ray_Flags,
		cull_mask:              i32,
		ray_origin:             [3]f32,
		ray_tmin:               f32,
		ray_direction:          [3]f32,
		ray_tmax:               f32,
	)

	RayQueryTerminateKHR                                             :: proc(#by_ptr query: Query)
	RayQueryGenerateIntersectionKHR                                  :: proc(#by_ptr query: Query, hit_t: f32)
	RayQueryConfirmIntersectionKHR                                   :: proc(#by_ptr query: Query)
	RayQueryProceedKHR                                               :: proc(#by_ptr query: Query) -> bool

	RayQueryGetRayTMinKHR                                            :: proc(#by_ptr query: Query) -> f32
	RayQueryGetRayFlagsKHR                                           :: proc(#by_ptr query: Query) -> Ray_Flags
	RayQueryGetIntersectionCandidateAABBOpaqueKHR                    :: proc(#by_ptr query: Query) -> bool
	RayQueryGetWorldRayDirectionKHR                                  :: proc(#by_ptr query: Query) -> [3]f32
	RayQueryGetWorldRayOriginKHR                                     :: proc(#by_ptr query: Query) -> [3]f32

	RayQueryGetIntersectionTypeKHR                                   :: proc(#by_ptr query: Query, #const intersection: Intersection) -> i32
	RayQueryGetIntersectionTKHR                                      :: proc(#by_ptr query: Query, #const intersection: Intersection) -> f32
	RayQueryGetIntersectionInstanceCustomIndexKHR                    :: proc(#by_ptr query: Query, #const intersection: Intersection) -> i32
	RayQueryGetIntersectionInstanceIdKHR                             :: proc(#by_ptr query: Query, #const intersection: Intersection) -> i32
	RayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetKHR :: proc(#by_ptr query: Query, #const intersection: Intersection) -> i32
	RayQueryGetIntersectionGeometryIndexKHR                          :: proc(#by_ptr query: Query, #const intersection: Intersection) -> i32
	RayQueryGetIntersectionPrimitiveIndexKHR                         :: proc(#by_ptr query: Query, #const intersection: Intersection) -> i32
	RayQueryGetIntersectionBarycentricsKHR                           :: proc(#by_ptr query: Query, #const intersection: Intersection) -> [2]f32
	RayQueryGetIntersectionFrontFaceKHR                              :: proc(#by_ptr query: Query, #const intersection: Intersection) -> bool
	RayQueryGetIntersectionObjectRayDirectionKHR                     :: proc(#by_ptr query: Query, #const intersection: Intersection) -> [3]f32
	RayQueryGetIntersectionObjectRayOriginKHR                        :: proc(#by_ptr query: Query, #const intersection: Intersection) -> [3]f32
	RayQueryGetIntersectionObjectToWorldKHR                          :: proc(#by_ptr query: Query, #const intersection: Intersection) -> matrix[4, 3]f32
	RayQueryGetIntersectionWorldToObjectKHR                          :: proc(#by_ptr query: Query, #const intersection: Intersection) -> matrix[4, 3]f32
}

initialize                                  :: RayQueryInitializeKHR
terminate                                   :: RayQueryTerminateKHR
generate_intersection                       :: RayQueryGenerateIntersectionKHR
confirm_intersection                        :: RayQueryConfirmIntersectionKHR
proceed                                     :: RayQueryProceedKHR
get_ray_t_min                               :: RayQueryGetRayTMinKHR
get_ray_flags                               :: RayQueryGetRayFlagsKHR
get_intersection_candidate_aabb_opaque      :: RayQueryGetIntersectionCandidateAABBOpaqueKHR
get_world_ray_direction                     :: RayQueryGetWorldRayDirectionKHR
get_world_ray_origin                        :: RayQueryGetWorldRayOriginKHR

get_intersection_type                       :: RayQueryGetIntersectionTypeKHR
get_intersection_t                          :: RayQueryGetIntersectionTKHR
get_intersection_instance_custom_index      :: RayQueryGetIntersectionInstanceCustomIndexKHR
get_intersection_instance_id                :: RayQueryGetIntersectionInstanceIdKHR
get_intersection_instance_sbt_record_offset :: RayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetKHR
get_intersection_geometry_index             :: RayQueryGetIntersectionGeometryIndexKHR
get_intersection_primitive_index            :: RayQueryGetIntersectionPrimitiveIndexKHR
get_intersection_barycentrics               :: RayQueryGetIntersectionBarycentricsKHR
get_intersection_front_face                 :: RayQueryGetIntersectionFrontFaceKHR
get_intersection_object_ray_direction       :: RayQueryGetIntersectionObjectRayDirectionKHR
get_intersection_object_ray_origin          :: RayQueryGetIntersectionObjectRayOriginKHR
get_intersection_object_to_world            :: RayQueryGetIntersectionObjectToWorldKHR
get_intersection_world_to_object            :: RayQueryGetIntersectionWorldToObjectKHR
