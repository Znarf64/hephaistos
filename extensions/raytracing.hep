Acceleration_Structure :: opaque(TypeAccelerationStructureKHR)

Ray_Flag_Bits :: enum {
	Opaque                     = 0,
	NoOpaque                   = 1,
	TerminateOnFirstHit        = 2,
	SkipClosestHitShader       = 3,
	CullBackFacingTriangles    = 4,
	CullFrontFacingTriangles   = 5,
	CullOpaque                 = 6,
	CullNoOpaque               = 7,
	SkipTriangles              = 8,
	SkipAABBs                  = 9,
	ForceOpacityMicromap2State = 10,
}

Ray_Flags :: bit_set[Ray_Flag_Bits; i32]

Hit_Kind :: enum u32 {
	Front = 0xFE,
	Back  = 0xFF,
}

#capability(RayTracingKHR)

extension "SPV_KHR_ray_tracing" {
	ReportIntersectionKHR :: proc(hit: f32, hit_kind: Hit_Kind) -> bool
	IgnoreIntersectionKHR :: proc() -> !
	TerminateRayKHR       :: proc() -> !

	TraceRayKHR :: proc(
		acceleration_structure: Acceleration_Structure,
		ray_flags:              Ray_Flags,
		cull_mask:              i32,
		sbt_offset:             i32,
		sbt_stride:             i32,
		miss_index:             i32,
		ray_origin:             [3]f32,
		ray_tmin:               f32,
		ray_direction:          [3]f32,
		ray_tmax:               f32,
		#by_ptr payload:        any,
	)
}

trace_ray           :: TraceRayKHR
report_intersection :: ReportIntersectionKHR
ignore_intersection :: IgnoreIntersectionKHR
terminate_ray       :: TerminateRayKHR
